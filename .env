# FastAPI Webhook URL សម្រាប់ UserBot ផ្ញើ Data មក
# បញ្ជាក់៖ ប្រើឈ្មោះ service "api" ឬ "127.0.0.1" ទៅតាម Docker setup
FASTAPI_USERBOT_URL=http://api:8000/webhook/telegram-userbot

# PostgreSQL Database Connection (ប្រើ port 5432 និង container host "postgres")
DATABASE_URL=postgresql://postgres:123456@postgres:5432/postgres

# MQTT Broker Configuration (សម្រាប់ Y6B Soundbox)
# បញ្ជាក់៖ កែពី localhost ទៅឈ្មោះ Container "mosquitto" ឬ "soundbox_mqtt"
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USER=device_service
MQTT_PASSWORD=OSTsystem@123

# Internal Secret API Key (សម្រាប់ផ្ទៀងផ្ទាត់ Request សុវត្ថិភាព)
API_SECRET_KEY=your-api-key

# Speaker / Device API Endpoint ក្នុងស្រុក
DEVICE_API_URL=http://api:8000/api/v1/announce